# Copy to /etc/openinbox-telegram-notify.env and lock it down:
#   install -m 600 config.example.env /etc/openinbox-telegram-notify.env

# Your OpenInbox instance (no trailing slash)
OPENINBOX_URL=https://openinbox.example.workers.dev

# An OpenInbox account with the Admin role (needed to read the mail flow log).
# Tip: create a separate admin account just for this script.
OPENINBOX_EMAIL=notify@example.com
OPENINBOX_PASSWORD=change-me

# Telegram bot token from @BotFather and the chat ID that should get the messages
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
TELEGRAM_CHAT_ID=123456789

# Space-separated addresses that trigger a message. Aliases and +tag addresses work too.
WATCH="me@example.com work@example.com"

# Where the session cookie and the last seen ID are kept (optional)
#STATE_DIR=/var/lib/openinbox-telegram-notify
